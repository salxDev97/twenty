    "noteTarget": {
      "admin": { "all": true },
      "ceo": { "all": true },
      "coo": { "all": true },
      "salesHead": { "all": true },
      "deliveryHead": { "all": true },
      "sales": {
        "anyParent": {
          "parents": [
            { "foreignKey": "targetOpportunity", "object": "opportunity" }
