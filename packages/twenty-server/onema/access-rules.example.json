      "sales": {
        "or": [
          { "eq": ["accountOwner", "$me"] },
          {
            "exists": {
              "object": "opportunity",
              "backForeignKey": "company",
              "where": { "eq": ["owner", "$me"] }
            }
          }
        ]
      }
    },
    "person": {
      "admin": { "all": true },
      "ceo": { "all": true },
      "coo": { "all": true },
      "salesHead": { "all": true },
      "sales": {
        "or": [
          { "parent": { "foreignKey": "company", "object": "company" } },
          {
            "exists": {
              "object": "opportunity",
              "backForeignKey": "pointOfContact",
              "where": { "eq": ["owner", "$me"] }
