      "ceo": { "all": true },
      "coo": { "all": true },
      "salesHead": { "all": true },
      "deliveryHead": { "all": true },
      "sales": {
        "and": [
          {
            "anyParent": {
              "parents": [
                { "foreignKey": "targetOpportunity", "object": "opportunity" },
                { "foreignKey": "targetCompany", "object": "company" },
                { "foreignKey": "targetPerson", "object": "person" },
                { "foreignKey": "targetTask", "object": "task" },
                { "foreignKey": "targetNote", "object": "note" }
              ]
            }
          },
          {
            "or": [
              { "eq": ["linkedObjectMetadataId", null] },
              {
                "linked": {
                  "objectIdField": "linkedObjectMetadataId",
                  "recordIdField": "linkedRecordId",
                  "objects": [
                    "opportunity",
                    "company",
                    "person",
                    "task",
                    "note"
                  ]
                }
              }
            ]
          }
        ]
      },
