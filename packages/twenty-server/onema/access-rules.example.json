      "ceo": { "all": true },
      "coo": { "all": true },
      "salesHead": { "all": true },
      "deliveryHead": { "all": true },
      "sales": {
        "anyParent": {
          "parents": [
            { "foreignKey": "targetOpportunity", "object": "opportunity" },
            { "foreignKey": "targetCompany", "object": "company" },
            { "foreignKey": "targetPerson", "object": "person" },
            { "foreignKey": "targetTask", "object": "task" },
            { "foreignKey": "targetNote", "object": "note" }
          ]
        }
      },
      "projectManager": {
        "anyParent": {
          "parents": [
            { "foreignKey": "targetOpportunity", "object": "opportunity" },
            { "foreignKey": "targetCompany", "object": "company" },
            { "foreignKey": "targetPerson", "object": "person" },
            { "foreignKey": "targetTask", "object": "task" },
            { "foreignKey": "targetNote", "object": "note" }
          ]
        }
      },
      "contractor": {
        "anyParent": {
          "parents": [
            { "foreignKey": "targetTask", "object": "task" },
            { "foreignKey": "targetNote", "object": "note" }
          ]
        }
      }
    },
    "note": {
      "admin": { "all": true },
      "ceo": { "all": true },
      "coo": { "all": true },
      "salesHead": { "all": true },
      "deliveryHead": { "all": true },
      "sales": {
        "or": [
          { "exists": { "object": "noteTarget", "backForeignKey": "note" } },
          { "eq": ["createdByWorkspaceMemberId", "$me"] }
