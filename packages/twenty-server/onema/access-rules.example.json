      "projectManager": {
        "anyParent": {
          "parents": [
            { "foreignKey": "targetOpportunity", "object": "opportunity" }
          ]
        }
      }
    },
    "taskTarget": {
      "admin": { "all": true },
      "ceo": { "all": true },
      "coo": { "all": true },
      "salesHead": { "all": true },
      "deliveryHead": { "all": true },
      "sales": {
        "anyParent": {
          "parents": [
            { "foreignKey": "targetOpportunity", "object": "opportunity" },
            { "foreignKey": "targetCompany", "object": "company" },
            { "foreignKey": "targetPerson", "object": "person" }
          ]
        }
      },
      "projectManager": {
        "anyParent": {
          "parents": [
            { "foreignKey": "targetOpportunity", "object": "opportunity" },
            { "foreignKey": "targetCompany", "object": "company" },
            { "foreignKey": "targetPerson", "object": "person" }
          ]
        }
      }
    },
    "timelineActivity": {
