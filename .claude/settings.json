{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-enterprise.sh",
            "timeout": 10,
            "statusMessage": "Clean-room: лицензия Enterprise"
          }
        ]
      }
    ]
  }
}
